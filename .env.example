# --- Core ---
IMOGEN_PORT=3000
IMOGEN_PUBLIC_URL=http://localhost:3000
# 32+ char secret used to sign tokens. Generated and persisted on first run if unset.
IMOGEN_SECRET=

# --- Database ---
DATABASE_URL=postgres://imogen:imogen@localhost:5432/imogen

# --- Storage ---
IMOGEN_DATA_DIR=./data

# --- Registration ---
# Whether new users may sign up with email + password. First user is always allowed.
IMOGEN_ALLOW_SIGNUP=true

# --- OIDC single sign-on (optional; e.g. Authentik, Keycloak, Google) ---
IMOGEN_OIDC_ISSUER=
IMOGEN_OIDC_CLIENT_ID=
IMOGEN_OIDC_CLIENT_SECRET=
IMOGEN_OIDC_SCOPES=openid profile email
# Claim containing group membership, and the group that grants admin.
IMOGEN_OIDC_ADMIN_CLAIM=groups
IMOGEN_OIDC_ADMIN_VALUE=imogen-admins
# Display name for the SSO button in the web UI.
IMOGEN_OIDC_LABEL=Single sign-on
# Where the provider keeps its account page. Guessed from the issuer for Authentik and
# Keycloak; set it explicitly for anything else.
IMOGEN_OIDC_ACCOUNT_URL=

# --- Media ---
IMOGEN_FFMPEG_PATH=ffmpeg
IMOGEN_FFPROBE_PATH=ffprobe
# libheif decoder, used for tiled HEIC that ffmpeg mis-decodes.
IMOGEN_HEIF_DEC_PATH=heif-dec
IMOGEN_JOB_CONCURRENCY=4
IMOGEN_TRASH_RETENTION_DAYS=30
